{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MAB-APP registry",
  "type": "object",
  "required": ["apps"],
  "properties": {
    "$schema": { "type": "string" },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "platform", "status", "description", "icon", "link", "tech_stack"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Slug unik, jadi URL /app/<id>" },
          "name": { "type": "string" },
          "category": { "enum": ["application", "game", "business", "education"] },
          "platform": { "type": "array", "minItems": 1, "items": { "enum": ["desktop", "mobile", "web"] } },
          "status": { "enum": ["riset", "beta", "rilis"] },
          "description": { "type": "string", "maxLength": 160 },
          "icon": { "type": "string", "description": "Nama ikon Lucide (lihat packages/ui/src/icons.tsx)" },
          "link": { "type": "string", "description": "URL publik, kosongkan jika belum rilis" },
          "tech_stack": { "type": "array", "items": { "type": "string" } },
          "long_description": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "featured": { "type": "boolean" },
          "updated": { "type": "string" }
        }
      }
    }
  }
}
