---
import Logo from './Logo.astro';
import { SITE } from '@/lib/site';
const year = new Date().getFullYear();
---
<footer class="border-t border-white/10">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-5 py-10 text-sm text-slate-400 sm:flex-row">
    <p class="flex items-center gap-2.5 font-display font-semibold text-slate-200"><Logo /> MAB-APP</p>
    <p>© {year} {SITE.name}. Built with Astro on a 100% free stack.</p>
    <a href={SITE.github} target="_blank" rel="noopener noreferrer" class="text-slate-300 underline-offset-4 hover:text-white hover:underline">Source on GitHub</a>
  </div>
</footer>
