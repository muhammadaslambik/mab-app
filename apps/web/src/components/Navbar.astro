---
import Logo from './Logo.astro';
import { SITE } from '@/lib/site';
import { withBase } from '@/lib/url';

const links = [
  { href: withBase('#vault'), label: 'Vault' },
  { href: withBase('#about'), label: 'Why MAB-APP' },
  { href: SITE.github, label: 'GitHub', external: true },
];
---
<header id="site-header" data-scrolled="false"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors duration-300 data-[scrolled=true]:border-white/10 data-[scrolled=true]:bg-ink-950/90">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5" aria-label="Main">
    <a href={withBase('')} class="flex items-center gap-2.5 font-display text-lg font-bold tracking-tight text-white">
      <Logo /> MAB-APP
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {links.map((l) => (
        <li>
          <a href={l.href} class="rounded-full px-4 py-2 text-sm text-slate-300 transition hover:bg-white/5 hover:text-white"
            {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{l.label}</a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <button type="button" data-install hidden class="btn btn-ghost !px-4 !py-1.5"><span>Install<span class="hidden sm:inline"> app</span></span></button>
      <button id="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Toggle menu"
        class="grid h-10 w-10 place-items-center rounded-full border border-white/10 bg-white/5 text-slate-200 md:hidden">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" hidden class="border-t border-white/10 bg-ink-950/95 px-5 py-4 md:hidden">
    <ul class="flex flex-col gap-1">
      {links.map((l) => (
        <li><a href={l.href} class="block rounded-xl px-3 py-3 text-slate-200 hover:bg-white/5"
          {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{l.label}</a></li>
      ))}
    </ul>
  </div>
</header>