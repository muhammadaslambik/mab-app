---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---
<BaseLayout title="Page not found" noindex>
  <section class="mx-auto flex min-h-[80svh] max-w-xl flex-col items-center justify-center px-5 text-center">
    <p class="font-display text-7xl font-bold text-white">404</p>
    <h1 class="mt-4 text-2xl font-semibold text-white" data-i18n="notfound.title">This page is not in the vault</h1>
    <p class="mt-2 text-slate-300" data-i18n="notfound.desc">The link may be outdated, or the app was renamed.</p>
    <a href={withBase('#vault')} class="btn btn-primary mt-8"><span data-i18n="notfound.cta">Browse all apps</span></a>
  </section>
</BaseLayout>
