---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Bento from '../components/Bento.astro';
import AppExplorer from '../components/AppExplorer';
import { getApps, getStats } from '../lib/registry';
import { withBase } from '../lib/url';
import { SITE } from '../lib/site';

const all = getApps();
const stats = getStats(all);
// Kirim ke island tanpa long_description → payload HTML tetap kecil saat app mencapai 100+
const apps = all.map(({ long_description, ...rest }) => rest);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
};
---
<BaseLayout jsonLd={jsonLd}>
  <Hero stats={stats} />
  <Bento />

  <section id="vault" class="mx-auto max-w-6xl px-5 pb-24 pt-8 sm:pb-28">
    <div class="mb-6 max-w-2xl sm:mb-8" data-reveal>
      <h2 class="text-3xl font-bold text-white sm:text-4xl" data-i18n="vault.title">The vault</h2>
      <p class="mt-3 text-slate-300" data-i18n="vault.subtitle">Every app in the lab. Search, filter and open any of them for details.</p>
    </div>
    <!-- Island React: render di server (SEO), interaktif setelah hydrate -->
    <AppExplorer client:load apps={apps} appBase={withBase('app/')} />
    <noscript><style>[data-card]{opacity:1!important;transform:none!important}</style></noscript>
  </section>
</BaseLayout>
